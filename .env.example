# Local mode binds to loopback and uses embedded PostgreSQL. No secrets belong in source.
HOST=127.0.0.1
PORT=4317
AVAFEM_MODE=sandbox
# For a PostgreSQL server instead of embedded PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/avafem
# Production must set these secrets and disable local bootstrap.
# AVAFEM_SESSION_SECRET=
# AVAFEM_CREDENTIAL_ENCRYPTION_KEY=
# AVAFEM_ADMIN_TOKEN=
# AVAFEM_ALLOW_LOCAL_BOOTSTRAP=false
# Stripe is disconnected until a test secret and endpoint secret are supplied.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Shopify local client secret defaults to the existing macOS Keychain item.
SHOPIFY_SHOP=i4vd1u-s8.myshopify.com
SHOPIFY_CLIENT_ID=e4d70eed35b16d38f81e3af32a35dd65
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_WEBHOOK_SECRET= # Shopify app client secret, unless supplied separately
# Per-brand offline OAuth uses an explicitly configured app client, not the own-store Keychain entry.
# SHOPIFY_OAUTH_CLIENT_ID=
# SHOPIFY_OAUTH_CLIENT_SECRET=
# Public HTTPS URL required before OAuth callbacks or webhooks can be registered.
# PUBLIC_BASE_URL=https://...
# Optional future setup: disabled by default. Do not enable for local-only tests.
# AVAFEM_ENABLE_STORE_DISCOVERY=false
# AVAFEM_ENABLE_INVITE_EMAIL=false
# RESEND_API_KEY=configure-only-in-server-secret-environment
# AVAFEM_INVITE_EMAIL_FROM=invites@example.com
# Acceptance configuration only; preflight does not execute provider scenarios.
# AVAFEM_ACCEPTANCE_STORES=i4vd1u-s8.myshopify.com,qpsd02-jz.myshopify.com,ir7112-v1.myshopify.com
# AVAFEM_ACCEPTANCE_EVIDENCE=/absolute/private/path/to/redacted-evidence-manifest.json
